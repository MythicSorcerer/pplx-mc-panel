FROM eclipse-temurin:25-jre-alpine

RUN apk add --no-cache curl bash openssl

WORKDIR /data

ENV TZ=UTC

EXPOSE 25565 25575 25585

RUN echo -e "#!/bin/sh\necho 'rcon-cli not installed - use console or api'\nexit 1" > /usr/local/bin/rcon-cli && chmod +x /usr/local/bin/rcon-cli

COPY server.jar /data/server.jar

RUN echo "eula=true" > /data/eula.txt

ENV XMS=1G XMX=2G JVM_ARGS="-Dterminal.ansi=true -XX:+UseZGC"

CMD ["sh", "-c", "java $JVM_ARGS -Xms$XMS -Xmx$XMX -jar server.jar nogui"]